AGENT_V1_ENABLED=true
AGENT_V1_DEMO_MODE=true
AGENT_V1_RUN_STORE=sqlite
AGENT_V1_AUTH_ENABLED=false
AGENT_V1_USE_PLATFORM_FILES=false
AGENT_V1_OUTPUT_TTL_SECONDS=86400

# Tool timeout tiers: fast, standard, long, deep report, child agent.
AGENT_TOOL_TIMEOUT_L1_SECONDS=30
AGENT_TOOL_TIMEOUT_L2_SECONDS=120
AGENT_TOOL_TIMEOUT_L3_SECONDS=300
AGENT_TOOL_TIMEOUT_L4_SECONDS=1200
AGENT_TOOL_TIMEOUT_L5_SECONDS=3600
